<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F1EC"
    tools:context=".RecuperarActivity">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:background="#7D523B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnRegresar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#FFFFFF"
            android:onClick="regresar"
            android:text="Regresar"
            android:textAllCaps="false"
            android:textColor="#7D523B"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="35dp"
            android:paddingTop="30dp"
            android:paddingEnd="35dp"
            android:paddingBottom="35dp">

            <TextView
                android:id="@+id/txtTituloRecuperar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Recuperar contraseña"
                android:textColor="#4A3428"
                android:textSize="28sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtUsuarioRecuperar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="35dp"
                android:backgroundTint="#6E6259"
                android:hint="Ingrese su usuario"
                android:hintTextColor="#AAA19A"
                android:inputType="text"
                android:textColor="#4A3428"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnBuscarUsuario"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="15dp"
                android:backgroundTint="#7D523B"
                android:onClick="buscarUsuario"
                android:text="Buscar usuario"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPreguntaRecuperacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:background="#E9DED7"
                android:padding="14dp"
                android:text="Pregunta de recuperación"
                android:textColor="#4A3428"
                android:textSize="17sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtRespuestaRecuperar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="15dp"
                android:backgroundTint="#6E6259"
                android:hint="Respuesta"
                android:hintTextColor="#AAA19A"
                android:inputType="text"
                android:textColor="#4A3428"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/txtNuevaPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#6E6259"
                android:hint="Nueva contraseña"
                android:hintTextColor="#AAA19A"
                android:inputType="textPassword"
                android:textColor="#4A3428"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/txtConfirmarPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#6E6259"
                android:hint="Confirmar nueva contraseña"
                android:hintTextColor="#AAA19A"
                android:inputType="textPassword"
                android:textColor="#4A3428"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnCambiarPassword"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#B58855"
                android:onClick="cambiarPassword"
                android:text="Cambiar contraseña"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
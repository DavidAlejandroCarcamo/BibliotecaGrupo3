<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FF"
    tools:context=".RecuperarActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="35dp"
            android:paddingTop="45dp"
            android:paddingEnd="35dp"
            android:paddingBottom="35dp">

            <Button
                android:id="@+id/btnRegresar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#6F50B5"
                android:onClick="regresar"
                android:text="Regresar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTituloRecuperar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:gravity="center"
                android:text="Recuperar contraseña"
                android:textColor="#3F3A46"
                android:textSize="28sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtUsuarioRecuperar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="35dp"
                android:hint="Ingrese su usuario"
                android:inputType="text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnBuscarUsuario"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="15dp"
                android:backgroundTint="#6F50B5"
                android:onClick="buscarUsuario"
                android:text="Buscar usuario"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPreguntaRecuperacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:background="#EEE7FA"
                android:padding="14dp"
                android:text="Pregunta de recuperación"
                android:textColor="#3F3A46"
                android:textSize="17sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtRespuestaRecuperar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="15dp"
                android:hint="Respuesta"
                android:inputType="text"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/txtNuevaPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Nueva contraseña"
                android:inputType="textPassword"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/txtConfirmarPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Confirmar nueva contraseña"
                android:inputType="textPassword"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnCambiarPassword"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#6F50B5"
                android:onClick="cambiarPassword"
                android:text="Cambiar contraseña"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
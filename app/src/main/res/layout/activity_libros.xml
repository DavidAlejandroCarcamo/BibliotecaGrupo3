<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FF"
    tools:context=".LibrosActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="35dp"
            android:paddingTop="35dp"
            android:paddingEnd="35dp"
            android:paddingBottom="35dp">

            <Button
                android:id="@+id/btnRegresar"
                android:layout_width="49dp"
                android:layout_height="45dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#6F50B5"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:onClick="regresar"
                android:paddingStart="0dp"
                android:paddingTop="0dp"
                android:paddingEnd="0dp"
                android:paddingBottom="8dp"
                android:text="←"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtTituloPantallaLibros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:text="Libros"
                android:textColor="#3F3A46"
                android:textSize="30sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtTituloLibro"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="25dp"
                android:hint="Título del libro"
                android:inputType="text"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/txtISBNLibro"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="ISBN"
                android:inputType="text"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/txtAnioLibro"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Año de publicación"
                android:inputType="number"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/txtStockLibro"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Stock"
                android:inputType="number"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/txtDescripcionLibro"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:gravity="top"
                android:hint="Descripción"
                android:inputType="textMultiLine"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/spAutor"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp" />

            <Spinner
                android:id="@+id/spEditorial"
                android:layout_width="match_parent"
                android:layout_height="50dp" />

            <Spinner
                android:id="@+id/spCategoria"
                android:layout_width="match_parent"
                android:layout_height="50dp" />

            <Spinner
                android:id="@+id/spEstado"
                android:layout_width="match_parent"
                android:layout_height="50dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnGuardarLibro"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#6F50B5"
                    android:onClick="guardarLibro"
                    android:text="Guardar"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnActualizarLibro"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#6F50B5"
                    android:onClick="actualizarLibro"
                    android:text="Actualizar"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnLimpiar"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#8D77CC"
                    android:onClick="limpiarCampos"
                    android:text="Limpiar"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnEliminarLibro"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#8D77CC"
                    android:onClick="eliminarLibro"
                    android:text="Eliminar"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtListaTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:gravity="center"
                android:text="Lista de libros"
                android:textColor="#3F3A46"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ListView
                android:id="@+id/listaLibros"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="12dp"
                android:background="#EEE7FA" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
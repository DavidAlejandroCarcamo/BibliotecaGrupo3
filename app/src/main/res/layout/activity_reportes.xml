<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F1EC"
    tools:context=".ReportesActivity">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:background="#7D523B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnRegresar"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:backgroundTint="#FFFFFF"
            android:onClick="regresar"
            android:text="Regresar"
            android:textAllCaps="false"
            android:textColor="#7D523B"
            android:textStyle="bold"
            app:cornerRadius="24dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="35dp"
            android:paddingTop="30dp"
            android:paddingEnd="35dp"
            android:paddingBottom="35dp">

            <TextView
                android:id="@+id/txtTituloReportes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Reportes"
                android:textColor="#4A3428"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtituloCatalogo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Resumen del catálogo"
                android:textColor="#7D523B"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTotalLibros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#E9DED7"
                android:padding="14dp"
                android:text="Libros registrados: 0"
                android:textColor="#4A3428"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/txtTotalAutores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#E9DED7"
                android:padding="14dp"
                android:text="Autores registrados: 0"
                android:textColor="#4A3428"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/txtTotalEditoriales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#E9DED7"
                android:padding="14dp"
                android:text="Editoriales registradas: 0"
                android:textColor="#4A3428"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/txtTotalCategorias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#E9DED7"
                android:padding="14dp"
                android:text="Categorías registradas: 0"
                android:textColor="#4A3428"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/txtSubtituloEjemplares"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Estado de ejemplares"
                android:textColor="#7D523B"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtEjemplaresDisponibles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#E9DED7"
                android:padding="14dp"
                android:text="Ejemplares disponibles: 0"
                android:textColor="#4A3428"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/txtEjemplaresPrestados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#E9DED7"
                android:padding="14dp"
                android:text="Ejemplares prestados: 0"
                android:textColor="#4A3428"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/txtEjemplaresDanados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#E9DED7"
                android:padding="14dp"
                android:text="Ejemplares dañados: 0"
                android:textColor="#4A3428"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/txtSubtituloPrestamos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Préstamos y devoluciones"
                android:textColor="#7D523B"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPrestamosActivos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#E9DED7"
                android:padding="14dp"
                android:text="Préstamos activos: 0"
                android:textColor="#4A3428"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/txtPrestamosDevueltos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#E9DED7"
                android:padding="14dp"
                android:text="Préstamos devueltos: 0"
                android:textColor="#4A3428"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/txtPrestamosCancelados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#E9DED7"
                android:padding="14dp"
                android:text="Préstamos cancelados: 0"
                android:textColor="#4A3428"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/txtTotalDevoluciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#E9DED7"
                android:padding="14dp"
                android:text="Devoluciones registradas: 0"
                android:textColor="#4A3428"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/txtSubtituloUsuarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Usuarios"
                android:textColor="#7D523B"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtUsuariosActivos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#E9DED7"
                android:padding="14dp"
                android:text="Usuarios activos: 0"
                android:textColor="#4A3428"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/txtUsuariosInactivos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#E9DED7"
                android:padding="14dp"
                android:text="Usuarios inactivos: 0"
                android:textColor="#4A3428"
                android:textSize="17sp" />

            <Button
                android:id="@+id/btnActualizarReporte"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="25dp"
                android:backgroundTint="#7D523B"
                android:onClick="actualizarReporte"
                android:text="Actualizar reporte"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="28dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
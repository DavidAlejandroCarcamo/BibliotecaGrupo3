<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F1EC"
    tools:context=".EjemplaresActivity">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:background="#7D523B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnRegresar"
            android:layout_width="60dp"
            android:layout_height="45dp"
            android:backgroundTint="#FFFFFF"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:onClick="regresar"
            android:paddingStart="0dp"
            android:paddingTop="0dp"
            android:paddingEnd="0dp"
            android:paddingBottom="6dp"
            android:text="←"
            android:textAllCaps="false"
            android:textColor="#7D523B"
            android:textSize="22sp"
            android:textStyle="bold"
            app:cornerRadius="24dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="35dp"
            android:paddingTop="30dp"
            android:paddingEnd="35dp"
            android:paddingBottom="35dp">

            <TextView
                android:id="@+id/txtTituloEjemplares"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Ejemplares"
                android:textColor="#4A3428"
                android:textSize="30sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spLibro"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="25dp"
                android:backgroundTint="#6E6259" />

            <EditText
                android:id="@+id/txtCodigoInventario"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#6E6259"
                android:hint="Código de inventario"
                android:inputType="text"
                android:textColor="#4A3428"
                android:textColorHint="#AAA19A"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/txtUbicacion"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#6E6259"
                android:hint="Ubicación"
                android:inputType="text"
                android:textColor="#4A3428"
                android:textColorHint="#AAA19A"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/txtFechaRegistro"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#6E6259"
                android:hint="Fecha de registro  Ej: 2026-08-03"
                android:inputType="date"
                android:textColor="#4A3428"
                android:textColorHint="#AAA19A"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/spEstadoEjemplar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#6E6259" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnGuardarEjemplar"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#7D523B"
                    android:onClick="guardarEjemplar"
                    android:text="Guardar"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:cornerRadius="28dp" />

                <Button
                    android:id="@+id/btnActualizarEjemplar"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#7D523B"
                    android:onClick="actualizarEjemplar"
                    android:text="Actualizar"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:cornerRadius="28dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnLimpiar"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#B58855"
                    android:onClick="limpiarCampos"
                    android:text="Limpiar"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:cornerRadius="28dp" />

                <Button
                    android:id="@+id/btnEliminarEjemplar"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#B58855"
                    android:onClick="eliminarEjemplar"
                    android:text="Eliminar"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:cornerRadius="28dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtListaTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="Lista de ejemplares"
                android:textColor="#4A3428"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ListView
                android:id="@+id/listaEjemplares"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="12dp"
                android:background="#E9DED7" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>